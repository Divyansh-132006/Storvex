PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://127.0.0.1:27017/ufds
# Optional Node.js DNS override if the system resolver rejects MongoDB SRV lookups.
MONGODB_DNS_SERVERS=
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://storvexx.onrender.com/api/auth/google/callback
FRONTEND_URL=https://storvex.onrender.com
COOKIE_DOMAIN=
DISTRIBUTED_STORAGE_URL=
DISTRIBUTED_STORAGE_TIMEOUT_MS=900000
# Match JWT_ACCESS_SECRET and MONGODB_URI with the 4+1 storage service.
INTERNAL_SERVICE_TOKEN=
# Legacy GridFS uploads are disabled unless explicitly enabled.
ALLOW_LEGACY_UPLOAD=false
