PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ufds
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_COOKIE_NAME=ufds_rt
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
MASTER_KEY_V1=
CURRENT_KEY_VERSION=1
STORAGE_DIR=./storage/encrypted
MAX_FILE_SIZE_MB=500
MAX_USER_STORAGE_MB=2048
UNIT_SIZE_BYTES=1048576
VERIFY_CIPHERTEXT_HASH_ON_DOWNLOAD=true
SHARD_SIZE_BYTES=1048576
UPLOAD_GROUP_CONCURRENCY=2
UPLOAD_MIN_SHARDS_PER_GROUP=5
VERIFY_READBACK=true
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MAX_RETRIES=3
PENDING_TIMEOUT_MINUTES=30
ENABLE_FAULT_INJECTION=false
PROVIDER_1_TYPE=gridfs
PROVIDER_2_TYPE=gridfs
PROVIDER_3_TYPE=gridfs
PROVIDER_4_TYPE=gridfs
PROVIDER_5_TYPE=gridfs
# Optional: PROVIDER_N_MONGODB_URI
# S3 providers: PROVIDER_N_ENDPOINT, _REGION, _BUCKET, _ACCESS_KEY_ID,
# _SECRET_ACCESS_KEY and _FORCE_PATH_STYLE
